{
  "expo": {
    "name": "StayFit",
    "slug": "stayfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "gymapp",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.ezatu.stayfit"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "StayFit braucht Zugriff auf deine Fotos für den Fortschritts-Tab.",
          "cameraPermission": "StayFit braucht Kamera-Zugriff für Progress-Fotos."
        }
      ],
      "expo-sharing",
      "expo-video"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8abeced7-4fd7-4ff2-864d-a04b52cafe98"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8abeced7-4fd7-4ff2-864d-a04b52cafe98"
    }
  }
}
